{
  "name": "devmetrics-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DevMetrics — GitHub analytics dashboard backend (Fastify + Drizzle + Turso)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.2.0",
    "@libsql/client": "^0.15.15",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "tsx": "^4.20.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.9.4",
    "drizzle-kit": "^0.31.6",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3"
  }
}
