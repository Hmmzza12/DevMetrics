# ─────────────────────────────────────────────────────────────
# DevMetrics — Backend environment
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend origin — used for CORS and the post-login redirect.
FRONTEND_URL=http://localhost:5173

# ── Turso (libSQL) ───────────────────────────────────────────
# For local dev you can use a local file: TURSO_DATABASE_URL=file:local.db
# For Turso cloud: libsql://<db-name>-<org>.turso.io + an auth token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# ── GitHub OAuth App ─────────────────────────────────────────
# Create at: https://github.com/settings/developers
# Authorization callback URL (dev): http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ── Anthropic (AI summary) ───────────────────────────────────
ANTHROPIC_API_KEY=

# ── GitHub PAT — server-side token for PUBLIC (no-login) lookups ─
# Public read scope only (public_repo / read:user). Gives 5000 req/hr vs the
# 60/hr anonymous limit. Never exposed to the client. Blank disables public mode.
GITHUB_PAT=

# ── Secrets ──────────────────────────────────────────────────
# SESSION_SECRET: used to derive the secure-session cookie key. Min 32 chars.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# TOKEN_ENCRYPTION_KEY: 64 hex chars (32 bytes) used to AES-256-GCM encrypt
# GitHub access tokens at rest. If omitted, it is derived from SESSION_SECRET.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
